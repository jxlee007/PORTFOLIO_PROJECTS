---
import Sidebar from './Sidebar.astro';
import Peace from './Peace.astro';
import Icon from './icon.astro';

interface MenuItem {
  href: string;
  index: string;
  label: string;
}

interface BrandLink {
  href: string;
  text: string;
}

export interface Props {
  menuItems: MenuItem[];
  brandLinks: BrandLink[];
}

const { menuItems, brandLinks } = Astro.props;
---
<div id="nav" class="w-full px-8 py-8 flex items-center justify-between">
  <div class="flex items-center gap-4">
    <a id="remix" href="#" class="flex rounded-full bg-white font-semibold text-black px-3 duration-300">
      REMIX / &nbsp; <h5 id="realtime"></h5>
    </a>
    
    <Icon ico="/images/call.png" />
  </div>
  
  <span class="cursor-pointer flex items-center" onclick="openNav()">
    <div class="w-8 h-8 flex items-center border-2 border-white rounded-full bg-white">
      <Peace />
    </div>
  </span>
  
  <Sidebar {menuItems} {brandLinks} />
</div>