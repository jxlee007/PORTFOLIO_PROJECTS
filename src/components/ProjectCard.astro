---
const { href, src, title, subtitle } = Astro.props;
---
<figure class="relative max-w-3xl transition-all duration-300 cursor-pointer">
  <a href={href}><img class="h-auto max-w-full rounded-lg" src={src} alt={title} /></a>
  <figcaption class="absolute px-4 md:px-10 text-sm md:text-lg text-white bottom-2 md:bottom-6">
    <h2 class="font-space-grotesk text-lg md:text-2xl font-bold">{title}</h2>
    <p class="uppercase text-sm md:text-xl font-space-grotesk tracking-wider leading-relaxed">{subtitle}</p>
  </figcaption>
</figure>