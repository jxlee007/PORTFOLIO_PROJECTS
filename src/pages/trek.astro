// Fixed randomizer function
function getRandomImage(value) {
  if (typeof value === "string") {
    if (value.trim().startsWith("[") && value.trim().endsWith("]")) {
      try {
        const urls = value
          .replace(/[\[\]]/g, "")
          .split(",")
          .map((url) => url.trim())
          .filter((url) => url.length > 0);

        if (urls.length > 0) {
          return urls[Math.floor(Math.random() * urls.length)];
        }
      } catch (e) {
        console.error("Error parsing image array:", e);
        return value;
      }
    }
    return value;
  }

  if (Array.isArray(value)) {
    return value[Math.floor(Math.random() * value.length)];
  }

  return value;
}

function randomizeImageSources(obj) {
  if (Array.isArray(obj)) {
    return obj.map((item) => randomizeImageSources(item));
  }

  if (obj !== null && typeof obj === "object") {
    const result = {};

    for (const [key, value] of Object.entries(obj)) {
      if (key === "src") {
        result[key] = getRandomImage(value);
      } else {
        result[key] = randomizeImageSources(value);
      }
    }

    return result;
  }

  return obj;
}

// Process data with randomization
const data = randomizeImageSources(trekdata);
---

<BaseLayout title="My Trek | JX7 Portfolio">
  <Nav {menuItems} {brandLinks} />

  <section class="mt-10 px-4 md:px-0">
    <div
      class="font-bold font-space-grotesk w-full gap-8 md:gap-12 flex flex-col items-center justify-center"
    >
      <span class="text-center">
        <Split text="LOOK INTO" />
        <Split text="MY TREK" />
      </span>

      <p
        class="w-full md:w-2/3 text-zinc-400 leading-relaxed text-xl md:text-3xl mt-6 text-center tracking-wide font-light px-4 md:px-0"
      >
        GET INTO MY PLAYGROUND, WHERE CREATIVITY TAKES FLIGHT AND IDEAS BLOSSOM
        THROUGH IMAGINATION. STEP INTO A REALM WHERE INSPIRATION MEETS
        EXPRESSION.
      </p>
    </div>
  </section>

  <section class="trek-page pt-[2%] md:pt-[5%] px-4 md:px-8">
    {
      data.sections.map((sectionGroup) => (
        <div class="section-group mb-24">
          {/* Hero Image Section */}
          <div class="hero-section relative h-96 md:h-[70vh] mb-16 md:mb-24 animate-item opacity-0 translate-y-6 will-change-transform overflow-hidden rounded-3xl shadow-2xl">
            <img
              src={sectionGroup.heroImage.src}
              alt={sectionGroup.heroImage.alt}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/30 to-black/60 flex items-center justify-center">
              <div class="text-center text-white/10 px-4 max-w-2xl sm:max-w-4xl ">
                <h1 class="text-4xl md:text-7xl font-bold mb-4 uppercase tracking-wider ">
                  {sectionGroup.heroImage.title}
                </h1>
                {sectionGroup.heroImage.subtitle && (
                  <p class="text-lg md:text-2xl font-light tracking-wide">
                    {/* {sectionGroup.heroImage.subtitle} */}
                  </p>
                )}
              </div>
            </div>
          </div>

          {/* Single Section Layout - Two Contents Side by Side with Image */}
          <div class="grid grid-cols-1 gap-8 md:gap-12 lg:grid-cols-2 lg:items-center mb-16 md:mb-24 animate-item opacity-0 translate-y-6">
            {/* Content Column */}
            <div class="order-1 space-y-8">
              {/* Two content blocks */}
              {sectionGroup.singleSection.contents.map((content, idx) => (
                <div class="space-y-4">
                  <h2 class="text-3xl font-bold mb-6 uppercase tracking-wide">
                    {sectionGroup.singleSection.contents[idx].title}
                  </h2>
                  <p class="text-base md:text-lg leading-relaxed text-gray-300">
                    {content.description}
                  </p>
                  {content.link && (
                    <a
                      href={content.link}
                      class="inline-flex items-center space-x-2 text-cyan-400 hover:text-cyan-300 font-semibold transition-colors duration-300 group"
                    >
                      <span>Learn More</span>
                      <span class="transform group-hover:translate-x-1 transition-transform duration-300">
                        →
                      </span>
                    </a>
                  )}
                </div>
              ))}
            </div>

            {/* Image Column */}
            <div class="order-2">
              <img
                src={sectionGroup.singleSection.image.src}
                alt={sectionGroup.singleSection.image.alt}
                class="w-full aspect-square object-cover rounded-xl shadow-2xl hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>

          {/* Dual Section Layout */}
          <div class="mb-16 md:mb-24 animate-item opacity-0 translate-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
              {/* Images container */}
              <div class="order-1 flex flex-col space-y-6 md:space-y-8">
                {sectionGroup.dualSection.images.map((image, index) => (
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="w-full object-cover aspect-[4/3] md:aspect-[4/3] sm:aspect-square rounded-xl shadow-2xl hover:scale-105 transition-transform duration-500"
                  />
                ))}
              </div>

              {/* Content container */}
              <div class="order-2 flex flex-col space-y-8 md:space-y-12">
                {sectionGroup.dualSection.contents.map((content, index) => (
                  <div class="space-y-4">
                    <h2 class="text-2xl md:text-4xl font-bold uppercase tracking-wide">
                      {content.title}
                    </h2>
                    <p class="text-base md:text-lg leading-relaxed text-gray-300">
                      {content.description}
                    </p>
                    {content.link && (
                      <a
                        href={content.link}
                        class="inline-flex items-center space-x-2 text-cyan-400 hover:text-cyan-300 font-semibold transition-colors duration-300 group"
                      >
                        <span>Learn More</span>
                        <span class="transform group-hover:translate-x-1 transition-transform duration-300">
                          →
                        </span>
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(() => {
        const items = Array.from(document.querySelectorAll(".animate-item"));
        if (!items.length) return;

        if (window.gsap && window.ScrollTrigger) {
          const gsap = window.gsap;
          const ScrollTrigger = window.ScrollTrigger;

          try {
            gsap.registerPlugin(ScrollTrigger);
          } catch (e) {
            console.error("GSAP registration failed:", e);
          }

          if (typeof ScrollTrigger.defaults === "function") {
            ScrollTrigger.defaults({ scroller: "#main" });
          }

          items.forEach((el, i) => {
            gsap.set(el, { autoAlpha: 0, y: 24 });
            gsap.to(el, {
              autoAlpha: 1,
              y: 0,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                scroller: "#main",
                toggleActions: "play none none reverse",
                markers: false,
              },
            });
          });

          ScrollTrigger.refresh();
          return;
        }

        // Fallback if GSAP not available
        items.forEach((el) => {
          el.classList.remove("opacity-0", "translate-y-6");
        });
      }, 120);
    });
  </script>

  <Footer />
</BaseLayout>
