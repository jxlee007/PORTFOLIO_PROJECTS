---
// BaseLayout.astro - Main layout component
import Dot from '../components/Dot.astro';
const { title = "JX7 Portfolio - Creative Developer & AI Builder" } = Astro.props;


---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="JX7 Portfolio - Creative Developer & AI Builder showcasing innovative web experiences" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>

    <!-- External CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@500,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=space-grotesk@500,400&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon and custom CSS -->
    <link rel="shortcut icon" href="/icon.ico" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/responsive.css" />
    
  </head>

  <body class="bg-black text-white">
    <!-- Loader -->
    <div id="loader">
      <h1>WELCOME</h1>
      <h1>TO</h1>
      <h1>JX7</h1>
    </div>

    <!-- Global Dot cursor -->
    <Dot />

    <!-- Main content container -->
    <main id="main" class="w-full min-h-screen bg-black px-2 md:px-10">
      <slot />
    </main>

    <!-- Scripts for animation and interaction -->
    <script
      src="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.min.js"
      is:inline></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"
      is:inline></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"
      is:inline></script>
    <script src="/scripts/script.js" is:inline></script>
  </body>
</html>