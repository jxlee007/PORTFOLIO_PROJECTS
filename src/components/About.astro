---
import Link from './Link.astro';
import CustomLink from './CustomLink.astro';
---
<section id="about" class="py-20 w-full h-fit flex flex-col items-center gap-12">
  <h1 class="w-full h-fit text-8xl font-space-grotesk font-semibold text-white text-center tracking-normal">
    LET'S WORK<br>TOGETHER
  </h1>

  <Link href="#contact" target="_self">CONTACT NOW*</Link>

  <div class="w-full grid grid-cols-3">
    <div class="py-56 text-center flex flex-col justify-between">
      <h2 class="uppercase text-lg font-space-grotesk tracking-wider leading-relaxed">
        Connect yourself<br>into Cyberpunk universe.
      </h2>
    </div>
    
    <div class="bg-white py-56 rounded-2xl mx-16 flex flex-col justify-between">
      <div class="flex flex-col gap-2">
        <!-- Contact form or content goes here -->
      </div>
    </div>
    
    <div class="py-56 text-center flex flex-col justify-between">
      <h2 class="uppercase text-lg font-space-grotesk tracking-wider leading-relaxed">
        Innovation is an<br>outlet for your vision.
      </h2>
    </div>
  </div>

  <p class="uppercase text-md font-semibold text-center tracking-wider w-1/2 px-16">
    <span class="text-white">
      I am always open to new opportunities and collaborations. If you have a project in mind or just want to say hi, feel free to reach out!
    </span>
  </p>

  <div class="font-space-grotesk text-xl font-thin w-1/3 flex justify-between">
    <CustomLink href="#" className="text-white hover:text-black hover:bg-white transition-colors duration-300">
      <span>INSTAGRAM<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
    <CustomLink href="#" className="text-white hover:text-black hover:bg-white transition-colors duration-300">
      <span>LINKEDIN<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
    <CustomLink href="#" className="text-white hover:text-black hover:bg-white transition-colors duration-300">
      <span>GITHUB<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
  </div>
</section>