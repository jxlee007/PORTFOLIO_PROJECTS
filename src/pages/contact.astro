---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Dot from "../components/Dot.astro";
import CustomLink from "../components/CustomLink.astro";

// Define menu items for the sidebar
const menuItems = [
    { href: "/", index: "/01", label: "MAIN HOME" },
    { href: "/about", index: "/02", label: "ABOUT JX7" },
    { href: "/work", index: "/03", label: "WORKS" },
    { href: "/trek", index: "/04", label: "MY TREK" },
    { href: "#contact", index: "/05", label: "CONTACT" },
];

// Define social media links
const brandLinks = [
    { href: "https://www.instagram.com/", text: "INSTAGRAM" },
    { href: "https://www.linkedin.com/", text: "LINKEDIN" },
    { href: "https://github.com/", text: "GITHUB" },
];
---

<BaseLayout title="CONTACT-JX7">
    <!-- Using the Dot component instead of hard-coded cursor dot -->
    <Dot />

    <!-- Hero section with just the navigation -->
    <div id="hero" class="w-full h-screen flex flex-col my-4">
        <Nav {menuItems} {brandLinks} />

        <!-- Hero content section - Responsive with flex direction changes -->
        <div
            class="w-full h-screen mt-10 flex flex-row justify-between gap-10"
        >
            <div class="mt-10 flex flex-col gap-16" id="form-section">
                <span class="flex flex-col items-start gap-6">
                    <p class="text-5xl font-bold uppercase text-left">RING A BELL!</p>

                    <p
                        class="uppercase text-gray-400 text-xl font-thin font-space-grotesk tracking-widest leading-relaxed text-left"
                    >
                        REACH OUT AND LET'S CREATE SOMETHING AMAZING
                        TOGETHER. LET'S ACHIEVE GREATNESS.
                    </p>
                </span>

                <!-- Form column - Takes full width on mobile -->
                <span class="rounded-2xl col-span-1 md:col-span-2">
                    <form class="flex flex-col gap-4 text-left">
                        <h3
                            class="text-gray-400 text-lg font-space-grotesk font-bold mb-4 uppercase text-left"
                        >
                            FILL THIS FORM OUT
                        </h3>

                        <!-- Stack form fields on mobile -->
                        <div
                            class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6"
                        >
                            <div class="flex flex-col">
                                <input
                                    type="text"
                                    id="name"
                                    class="bg-zinc-900 text-white text-xl p-4 rounded-xl border-0 uppercase"
                                    placeholder="NAME"
                                />
                            </div>

                            <div class="flex flex-col">
                                <input
                                    type="email"
                                    id="email"
                                    class="bg-zinc-900 text-white text-xl p-4 rounded-xl border-0 uppercase"
                                    placeholder="E-MAIL"
                                />
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <textarea
                                id="message"
                                rows="5"
                                class="bg-zinc-900 text-white text-xl p-4 rounded-xl border-0 resize-none uppercase"
                                placeholder="MESSAGE"></textarea>
                        </div>

                        <!-- Button is more prominent on mobile -->
                        <button
                            type="submit"
                            class="bg-white text-black p-6 uppercase rounded-xl font-semibold tracking-wide hover:bg-slate-300 transition-colors duration-300 w-full md:w-full text-xl text-left"
                        >
                            SEND EMAIL
                        </button>
                    </form>
                </span>
            </div>

            <section
                class="w-4/6 h-screen bg-amber-500"
                id="image-section"
            >
                <div class="h-full w-full overflow-hidden rounded-xl">
                    <img
                        src=""
                        alt="Contact image"
                        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    />
                </div>
            </section>
        </div>
    </div>

    <!-- Contact section - Fully responsive -->
    <div
        id="contact"
        class="mt-52 border-y border-gray-300 py-10 w-full h-fit flex flex-col md:flex-row items-center"
    >
        <!-- Responsive row layout with 4 blocks -->
        <div
            class="grid grid-cols-1 md:grid-cols-4 w-full text-left"
        >
            <!-- Block 4 -->
            <div class=" flex items-center justify-center">
                <div
                    class="text-xl font-space-grotesk font-medium flex flex-col"
                >
                    <p
                        class="pl-4 text-gray-400 text-lg uppercase font-medium text-left"
                    >
                        FOLLOW ME
                    </p>

                    <CustomLink
                        href="https://www.instagram.com/"
                        target="_blank"
                        className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                    >
                        <span
                            >INSTAGRAM<i
                                class="ri-arrow-right-up-line ml-1"
                            ></i></span
                        >
                    </CustomLink>
                    <CustomLink
                        href="https://www.linkedin.com/in/jagmohan-singh-malhi-a67805243/"
                        target="_blank"
                        className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                    >
                        <span
                            >LINKEDIN<i
                                class="ri-arrow-right-up-line ml-1"
                            ></i></span
                        >
                    </CustomLink>
                    <CustomLink
                        href="https://github.com/jxlee007"
                        target="_blank"
                        className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                    >
                        <span
                            >GITHUB<i
                                class="ri-arrow-right-up-line ml-1"
                            ></i></span
                        >
                    </CustomLink>
                </div>
            </div>

            <!-- Block 2 -->
            <div class="py-8 md:py-12 text-left rounded-2xl">
                <p class="text-gray-400 text-lg mb-3 md:mb-4 uppercase">
                    EMAIL ME
                </p>
                <p class="text-white text-xl mb-1 uppercase">
                    JAGMOHANSINGHMALHI20<br>@GMAIL.COM
                </p>
            </div>

            <div class="py-8 md:py-12 text-left rounded-2xl">
                <p class="text-gray-400 text-lg mb-3 md:mb-4 uppercase">
                    PHONE
                </p>
                <p class="text-white text-xl uppercase">+91 7600925494</p>
            </div>

            <!-- Block 3 -->
            <div
                class="py-8 md:py-12 text-left rounded-2xl"
            >
                <p class="text-gray-400 text-lg mb-3 md:mb-4 uppercase">CURRENT LOCATION</p>
                <p class="text-white text-xl uppercase">INDIA, GMT+5:30</p>
                <p class="text-white text-xl uppercase">GORWA, VADODARA</p>
                <p class="text-white text-xl uppercase">GUJARAT</p>
            </div>
        </div>
    </div>

    <!-- Footer section -->
    <div class="pt-20 border-t border-gray-800">
        <Footer goHref="#hero" title="JAGMOHAN" />
    </div>
</BaseLayout>