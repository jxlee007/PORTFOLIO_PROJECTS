---
import Link from './Link.astro';
import ProjectCard from './ProjectCard.astro';
import projectData from '../data/projects.json';

const projects = Array.isArray(projectData)
  ? projectData
  : projectData.projects ?? [];
---

<section id="third" class="py-10 md:py-14 w-full h-fit flex flex-col justify-items-end gap-8 md:gap-12 px-4 md:px-0">
  <h1 class="w-full h-fit grid grid-flow-col justify-items-center md:justify-items-end text-5xl md:text-8xl font-space-grotesk font-semibold text-white tracking-normal">
    FEATURED CASES
  </h1>

  <div class="grid grid-flow-row justify-items-start gap-6 md:gap-10">
    <span class="w-full md:w-3/5 md:pr-28 flex flex-col gap-4">
      <p class="uppercase text-white/80 text-lg md:text-xl line-clamp-4 font-space-grotesk tracking-wider leading-relaxed">
        My creative spirit comes alive in the digital realm. With nimble fingers flying across the keyboard, I craft clear experiences out of nothing but ones and zeroes.
      </p>
    </span>
    <Link href="/work">VIEW PORTFOLIO *</Link>
  </div>

  <!-- Projects Grid: 3x3 on desk/tab (md and up), 2x3 on phone (below md) -->
  <div class="w-full h-full mt-6">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
      {projects.slice(0, 9).map((project, idx) => (
        <div class={idx >= 6 ? "hidden md:block" : "block"}>
          <ProjectCard
            href={project.href}
            src={project.src}
            title={project.title}
          />
        </div>
      ))}
    </div>
  </div>
</section>