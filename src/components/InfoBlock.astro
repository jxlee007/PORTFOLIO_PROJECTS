---
const { title } = Astro.props;
---
<div class="w-full md:w-2/3 h-auto md:h-1/2 flex flex-col gap-3 md:gap-4">
  <h2 class="font-space-grotesk text-2xl md:text-3xl font-bold">{title}</h2>
  <p class=" text-gray-300 uppercase text-xl md:text-2xl font-space-grotesk tracking-widest leading-7">
    <slot />
  </p>
</div>