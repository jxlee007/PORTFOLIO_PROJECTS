---
import Link from './Link.astro';
import ProjectCard from './ProjectCard.astro';

const projects = [
  {
    id: 1,
    title: "PROJECT 1",
    subtitle: "/// Direct-biz",
    href: "#project1",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg"
  },
  {
    id: 2,
    title: "PROJECT 2",
    subtitle: "/// rayban-redesign",
    href: "#project2",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg"
  },
  {
    id: 3,
    title: "PROJECT 3",
    subtitle: "/// duo studio",
    href: "#project3",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg"
  },
  {
    id: 4,
    title: "PROJECT 4",
    subtitle: "/// sundown studios",
    href: "#project4",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg"
  }
];
---

<section id="third" class="py-20 w-full h-fit flex flex-col justify-items-end gap-12">
  <h1 class="w-full h-fit grid grid-flow-col justify-items-end text-8xl font-space-grotesk font-semibold text-white tracking-normal">
    FEATURED CASES
  </h1>

  <div class="grid grid-flow-row justify-items-start gap-10">
    <span class="w-1/2 pr-28 flex flex-col gap-4">
      <p class="uppercase text-2xl font-space-grotesk tracking-wider leading-relaxed">
        My creative spirit comes alive in the digital realm. With nimble fingers flying across the keyboard, 
        I craft clear experiences out of nothing but ones and zeroes.
      </p>
    </span>

    <Link href="/work">VIEW PORTFOLIO</Link>
  </div>

  <div class="w-full h-full">
    <div class="grid grid-cols-2 gap-2">
      {projects.map(project => (
        <ProjectCard 
          href={project.href}
          src={project.src}
          title={project.title}
          subtitle={project.subtitle}
        />
      ))}
    </div>
  </div>
</section>