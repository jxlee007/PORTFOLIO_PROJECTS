---
import CustomLink from './CustomLink.astro';

export interface Props {
  goHref?: string;
  title?: string;
}

const { goHref = "#hero", title = "JAGMOHAN" } = Astro.props;
const nameArray = title.split('');
---

<footer id="footer" class="w-full h-fit py-4 flex flex-col items-center gap-4 md:gap-5 px-4 md:px-0">
  <h1 class="font-space-grotesk font-bold text-[20vw] md:text-[14vw] -mt-16 md:-mt-28 -mb-8 md:-mb-16 tracking-wider transition duration-200 text-center">
    {nameArray.map(letter => <span>{letter}</span>)}
  </h1>

  <div class="w-full px-4 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-5">
    <div id="left" class="font-space-grotesk text-base md:text-lg uppercase tracking-wider font-thin text-center md:text-left">
      <h5>&copy; {new Date().getFullYear()} JGMHN DESIGNS</h5>
    </div>

    <div id="right" class="font-space-grotesk text-base md:text-lg uppercase tracking-wider font-thin">
      <CustomLink 
        id="back-to-top"
        href="#hero" 
        target="_self"
        className="text-white hover:text-black hover:bg-white transition-all duration-300 px-4 py-2 border border-white rounded-full opacity-0 invisible"
      >
        <span>Go back</span>
      </CustomLink>
    </div>
  </div>
</footer>