      <p
        class="w-full md:w-2/3 text-zinc-400 leading-relaxed text-lg md:text-xl mt-4 text-center tracking-wide font-light px-4 md:px-0"
      >
        UNLEASH YOUR CREATIVITY. SHOWCASE YOU WORK AND <br class="hidden md:block" />
        HIGHLIGHT YOUR UNIQUE SKILLS TO ATTRACT NEW CLIENTS.
      </p>
    </div>
  </section>

  <!-- Statistics Section -->
  <section class="flex flex-col gap-10 md:gap-14 px-4 md:px-0 py-6 md:py-10">
    <div class="flex flex-col gap-10 md:gap-16">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10 md:gap-0">
