import InfoBlock from "../components/InfoBlock.astro";

// Define menu items for the sidebar (same as index page)
const menuItems = [
  { href: "/", index: "/01", label: "MAIN HOME" },
  { href: "/about", index: "/02", label: "ABOUT JX7" },
  { href: "/work", index: "/03", label: "WORKS" },
  { href: "/trek", index: "/04", label: "MY TREK" },
  { href: "/contact", index: "/05", label: "CONTACT" },
];

// Capabilities
const capabilities = [
  {
    title: "LANDING PAGES & WEBSITES",
    description:
      "LANDING PAGE DESIGNED TO CONVERT VISITORS INTO ENGAGED USERS EFFORTLESSLY.",
    image: "/reference/about-page.png",
    price: "$ 320+",
  },
  {
    title: "MOBILE APPS",
    description:
      "LEADING THE FOREFRONT OF MOBILE APP DEVELOPMENT WITH ADVANCED TECHNOLOGIES.",
    image: "/reference/about-page.png",
    price: "$ 500+",
  },
  {
    title: "DIGITAL MARKETING AUTOMATION",
    description:
      "UNIQUE BRAND IDENTITIES THAT RESONATE WITH AUDIENCES MEMORABLE CONNECTIONS THROUGH STRATEGIC NARRATIVE FORGING.",
    image: "/reference/about-page.png",
    price: "$ 600+",
  },
];

const images = [
  {
    gif: "https://i.pinimg.com/originals/a7/7f/bf/a77fbfec380b3f63e3feb9a7df60616a.gif",
    text: "AWE SHIT"
  },
  {
    gif: "https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExczNwZTdoZ2xxeGM1Mml3czc1NnZzbGNrcmg1d3pxYjg0NHlvOTg5OSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/YbHnru6KfNiUGeNeCf/giphy.gif",
    text: "HERE .WE—GO"
  },
  {
    gif: "https://i.pinimg.com/originals/d8/e9/c4/d8e9c40a8542557a08f6f90745340112.gif",
    text: "AGAIN"
  },
];

// Define social media links
const brandLinks = [
  { href: "https://www.instagram.com/", text: "INSTAGRAM" },
  {
    href: "https://www.linkedin.com/in/jagmohan-singh-malhi-a67805243",
    text: "LINKEDIN",
  },
  { href: "https://github.com/jxlee007", text: "GITHUB" },
];

const contactDetails = [
  { label: "Mobile", value: "7600925494" },
  { label: "Email", value: "jagmohansinghmalhi20@gmail.com" },
  {
    label: "LinkedIn",
    value: "https://www.linkedin.com/in/jagmohan-singh-malhi-a67805243",
  },
  { label: "GitHub", value: "https://github.com/jxlee007" },
  ,
];
const topSkills = ["No-Code Development Platforms", "AI Agents", "Jira"];

const profileExperience = [
  {
    company: "Kit Solutions",
    position: "IT Business Analyst",
    period: "April 2024 - April 2025",
    location: "Vadodara, Gujarat, India",
  },
  {
    company: "InternPe",
    position: "Web Development Intern",
    period: "November 2023 - November 2023",
    location: "Jaipur, Rajasthan, India",
  },
];

const education = [
  {
    institution: "Parul University",
    degree: "Bachelor's in Computer Application, Cybersecurity",
    period: "August 2021 - April 2024",
  },
];

const stats = [
  {
    label: "Years of Experience",
    value: "4+",
  },
  {
    label: "Projects",
    value: "10+",
  },
  {
    label: "Creative Potential",
    value: "♾️",
  },
  {
    label: "Customer Satisfaction",
    value: "5.00",
  },
];
---

<BaseLayout title="About | JX7 Portfolio">
  <Nav {menuItems} {brandLinks} />

  <!-- Header -->
  <section class="mt-10 pb-6 md:pb-10 px-4 md:px-0">
    <div
      class="font-bold font-space-grotesk w-full gap-6 md:gap-10 flex flex-col items-center justify-center"
    >
      <span class="text-center">
        <Split text="MORE ABOUT " />
        <Split text="JXLEE" />
      </span>

      <p
        class="w-full md:w-2/3 text-zinc-400 leading-relaxed text-xl md:text-3xl mt-4 text-center tracking-wide font-light px-4 md:px-0"
      >
        UNLEASH YOUR CREATIVITY. SHOWCASE YOU WORK AND
        <br class="hidden md:block" />
        HIGHLIGHT YOUR UNIQUE SKILLS TO ATTRACT NEW CLIENTS.
      </p>
    </div>
  </section>

  <!-- Statistics -->
  <section class="px-4 md:px-0 py-6 md:py-10">
    <div
      class="flex flex-col md:flex-row items-center md:items-center justify-around gap-8 md:gap-6 w-full"
    >
      {
        stats.map((stat) => (
          <div class="flex-1 flex flex-col items-center animate-item opacity-0 translate-y-6 will-change-transform">
            <span class="text-5xl md:text-7xl lg:text-6xl font-bold font-space-grotesk text-white">
              {stat.value}
            </span>
            <span class="text-zinc-400 uppercase tracking-widest text-md mt-2 text-center md:text-left">
              {stat.label}
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <div class="w-full px-4 mt-10 flex flex-col items-end">
    <div
      class="mt-10 w-full lg:w-2/3 h-full grid grid-flow-row justify-items-end gap-4 md:gap-6"
    >
      <InfoBlock class="animate-item opacity-0 translate-y-6 will-change-transform" title="ABOUT JX7">
        I'm on the cutting edge of no-code tools that allow me to bring my
        creative visions to life. Though my methods may be unconventional, my
        dedication to the craft is unparalleled. I thrive on finding "unexpected
        solutions" and believe that with the right perspective.
      </InfoBlock>
    </div>

    <div
      class="mt-10 w-full lg:w-2/3 h-full grid grid-flow-row justify-items-end gap-4 md:gap-6"
    >
      <InfoBlock class="animate-item opacity-0 translate-y-6 will-change-transform" title="MY APPROACH & STRATEGY">
        I take a pragmatic, design-first approach — rapid code & AI prototyping
        to validate ideas, then polish with hand-crafted HTML/Tailwind/JS when
        it matters. I prioritize clear UX, automation that saves time, and fast
        iteration through collaboration and curiosity. Always down to build
        smart, beautiful experiences together.
      </InfoBlock>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="mt-8 w-full mx-auto animate-item opacity-0 translate-y-6 will-change-transform">
    <div class="relative overflow-hidden rounded-2xl shadow-lg bg-zinc-900">
      <!-- square on mobile, horizontal rectangle on md+ -->
      <div class="relative w-full pt-[100%] md:pt-[50%]">
        <img
          src="reference/188_256__avatar.webp"
          alt="Wide about hero"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>
    </div>
  </div>

  <!-- Experience -> LEFT shows full content sections (scrollable), RIGHT shows single pinned heading -->
  <div
    class="gallery mt-10 w-full flex flex-col lg:flex-row justify-between gap-6 md:gap-10"
  >
    <!-- LEFT: Full content sections (experience + education + profile) -->
    <div class="w-full lg:w-2/3 order-2 space-y-16 experience-content">
      {
        profileExperience.map((exp, i) => (
          <section class="experience-section animate-item opacity-0 translate-y-6 will-change-transform" id={`experience-item-${i + 1}`}>
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-wide mb-4">
              {exp.company}
            </h3>
            <p class="text-zinc-400 text-lg leading-relaxed">
              {exp.position} — {exp.period}
              <br />
              {exp.location}
            </p>
          </section>
        ))
      }

      {
        education.map((edu, i) => (
          <section
            class="education-section experience-section animate-item opacity-0 translate-y-6 will-change-transform"
            id={`education-item-${i + 1}`}
          >
            <h3 class="text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-wide mb-4">
              EDUCATION
            </h3>
            <p class="text-zinc-400 text-lg leading-relaxed">
              {edu.institution} — {edu.degree}
              <br />
              {edu.period}
            </p>
          </section>
        ))
      }

      <!-- shared end marker used by ScrollTrigger to calculate pin duration -->
      <hr id="experience-end" class="border border-transparent mt-2" />
    </div>

    <!-- RIGHT: Single pinned heading for the whole experience block -->
    <aside
      id="experience-headings"
      class="w-full lg:w-1/3 order-1 flex items-start"
    >
      <div class="w-full animate-item opacity-0 translate-y-6 will-change-transform">
        <h2
          id="experience-main-heading"
          class="text-5xl md:text-7xl lg:text-5xl font-bold tracking-wide uppercase"
        >
          EXPERIENCE
        </h2>
      </div>
    </aside>
  </div>

  <!-- My Stack Section -->
  <div class="my-24" id="my-stack">
    <div
      class="gallery-stack w-full flex flex-col lg:flex-row justify-between gap-8"
    >
      <!-- Left: My Stack heading (now on the left and will be pinned on large screens) -->
      <div
        class="md:pl-8 w-full lg:w-1/2 order-1 lg:order-1 flex items-start justify-start"
      >
        <h2
          id="my-stack-heading"
          class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-wide mb-8 uppercase lg:mb-0 lg:min-w-[220px] animate-item opacity-0 translate-y-6 will-change-transform"
        >
          MY STACK
        </h2>
      </div>

      <!-- Right: Stack cards (moved to the right) -->
      <div
        id="my-stack-cards"
        class="w-full lg:w-1/2 order-2 lg:order-2 flex flex-col gap-6"
      >
        <div
          class="bg-zinc-900 p-6 md:p-8 rounded-2xl shadow-lg hover:bg-zinc-800 transition-colors duration-300 animate-item opacity-0 translate-y-6 will-change-transform"
        >
          <h3
            class="text-xl md:text-2xl font-bold mb-4 uppercase tracking-wide"
          >
            DEVELOPMENT
          </h3>
          <ul class="text-zinc-400 space-y-3 text-lg">
            <li>HTML/CSS/JavaScript</li>
            <li>React/Next.js</li>
            <li>Astro</li>
            <li>Tailwind CSS</li>
            <li>WebGL/Three.js</li>
          </ul>
        </div>

        <div
          class="bg-zinc-900 p-6 md:p-8 rounded-xl hover:bg-zinc-800 transition-colors duration-300 animate-item opacity-0 translate-y-6 will-change-transform"
        >
          <h3
            class="text-xl md:text-2xl font-bold mb-4 uppercase tracking-wide"
          >
            NO-CODE
          </h3>
          <ul class="text-zinc-400 space-y-3 text-lg">
            <li>AI-SaaS</li>
            <li>Convex</li>
            <li>Figma</li>
            <li>Make</li>
            <li>AI Agents</li>
          </ul>
        </div>

        <div
          class="bg-zinc-900 p-6 md:p-8 rounded-xl hover:bg-zinc-800 transition-colors duration-300 animate-item opacity-0 translate-y-6 will-change-transform"
        >
          <h3
            class="text-xl md:text-2xl font-bold mb-4 uppercase tracking-wide"
          >
            TOOLS
          </h3>
          <ul class="text-zinc-400 space-y-3 text-lg">
            <li>Figma</li>
            <li>Framer</li>
            <li>VS Code</li>
            <li>GitHub</li>
            <li>Jira</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- end marker for GSAP pin end -->
    <hr id="my-stack-end" class="border border-transparent mt-6" />
  </div>

  <section class="w-full px-4 md:px-0">
    <div class="flex flex-col lg:flex-row gap-6 items-end">
      <!-- Left box -->
      <div
        class="w-full lg:w-1/2 p-6 md:p-8 order-2 lg:order-1 shadow-lg flex flex-col animate-item opacity-0 translate-y-6 will-change-transform"
      >
        <InfoBlock>
          A creator crafts visual narratives that blend creativity with
          functionality, shaping impactful experiences through artful design.
        </InfoBlock>
      </div>
      <!-- Right box -->
      <div
        class="w-full lg:w-1/2 text-4xl md:text-8xl order-1 lg:order-2 leading-tight md:leading-none font-space-grotesk animate-item opacity-0 translate-y-6 will-change-transform"
      >
        <h1 class="font-semibold text-white tracking-normal uppercase">
          AWE MAKES THINGS HAPPEN .wo—nder
         
        </h1>
      </div>
    </div>

    <!-- GIF Section -->
    <section class="my-8 w-screen md:w-full -mx-4 md:mx-0">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {
          images.slice(0, 3).map((img) => (
            <div class="group relative overflow-hidden rounded-lg animate-item opacity-0 translate-y-6 will-change-transform" style="padding-top:100%;">
              <img
                src={img.gif}
                alt="gif"
                class="absolute inset-0 w-full h-full object-cover"
              />

              <!-- overlay: visible on lg+, hides on hover -->
              <div
                class="absolute inset-0 hidden lg:flex items-center justify-center px-4 text-center bg-gradient-to-t from-gray-800 via-gray-700 to-gray-600 text-white transition-opacity duration-300 lg:opacity-100 lg:group-hover:opacity-0"
              >
                <p class="max-w-xs">
                  <span class="flex flex-col items-center">
                    <span class="w-16 h-px bg-white/20 mb-4" aria-hidden></span>
                    {
                      img.text.split(' ').map((word) => (
                        <span class="block text-5xl md:text-7xl font-bold uppercase tracking-wider bg-gradient-to-t from-gray-400 via-gray-300 to-gray-200 bg-clip-text text-transparent">
                          {word}
                        </span>
                      ))
                    }
                  </span>
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Capabilities -->
    <div class="my-14" id="capabilities">
      <div
        class="gallery-capabilities w-full flex flex-col lg:flex-row justify-between gap-8"
      >
        <!-- Left: Capabilities heading (can be pinned on large screens) -->
        <div class="md:pl-8 w-full lg:w-1/3 order-1 flex items-start">
          <h2
            id="capabilities-heading"
            class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-wide mb-8 uppercase lg:mb-0 animate-item opacity-0 translate-y-6 will-change-transform"
          >
            CAPABILITIES
          </h2>
        </div>

        <!-- Right: capability cards (image + content) -->
        <div
          class="w-full lg:w-2/3 order-2 grid grid-cols-1 place-items-center gap-6"
        >
          {
            capabilities.slice(0, 3).map((cap) => (
              <section class="capability-section flex flex-col my-6 bg-tranparent shadow-sm border border-gray-700 rounded-3xl w-full md:w-4/5 animate-item opacity-0 translate-y-6 will-change-transform">
                <div class="h-80 m-2.5 overflow-hidden text-white bg-white rounded-md">
                  <img
                    src={cap.image}
                    alt={cap.title}
                    class=" w-full h-full object-cover capability-image"
                  />
                </div>

                <div class="p-8">
                  <div class=" mb-4 flex flex-row gap-2 items-start ">
                    <h6 class="text-3xl tracking-wide font-semibold">
                      {cap.title}
                    </h6>

                    <p class="ml-3 hidden tracking-wider rounded-full bg-gray-100 px-2 py-0.5 text-lg font-medium whitespace-nowrap text-gray-700 lg:block dark:bg-gray-400/15 dark:text-gray-300">
                      {cap.price}
                    </p>
                  </div>

                  <p class="text-gray-300 uppercase text-lg tracking-wide leading-9">
                    {cap.description}
                  </p>
                </div>
              </section>
            ))
          }
        </div>
      </div>

      <!-- end marker for GSAP pin/end -->
      <hr id="capabilities-end" class="border border-transparent mt-6" />
    </div>
  </section>

  <!-- inline GSAP reveal: subtle on-scroll animations for .animate-item -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // small delay so GSAP/ScrollTrigger (if loaded) has a chance to register
      setTimeout(() => {
        const items = Array.from(document.querySelectorAll('.animate-item'));
        if (!items.length) return;

        // If GSAP + ScrollTrigger available, use it for smoother reveals
        if (window.gsap && window.ScrollTrigger) {
          const gsap = window.gsap;
          const ScrollTrigger = window.ScrollTrigger;
          try {
            gsap.registerPlugin(ScrollTrigger);
          } catch (e) {
            // plugin may already be registered
          }

          items.forEach((el, i) => {
            // ensure starting state (in case CSS classes removed)
            gsap.set(el, { autoAlpha: 0, y: 18 });
            gsap.to(el, {
              autoAlpha: 1,
              y: 0,
              duration: 0.6,
              ease: 'power2.out',
              delay: 0,
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                toggleActions: 'play none none reverse',
                markers: false,
              },
            });
          });
          return;
        }

        // Fallback (no GSAP): simply remove hidden classes for native appearance
        items.forEach((el) => {
          el.classList.remove('opacity-0', 'translate-y-6');
        });
      }, 120);
    });
  </script>
  <AboutComponent />

  <Footer />

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // small delay to allow other scripts/hydration to finish
      setTimeout(() => {
        if (!(window.gsap && window.ScrollTrigger)) return;
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        const mm = gsap.matchMedia();
        // keep references to created ScrollTriggers for cleanup
        const created = [];

        // Desktop: pins and image swap behavior
        mm.add("(min-width: 1024px)", () => {
          // EXPERIENCE heading pin
          const experienceHead = document.querySelector("#experience-headings");
          const experienceEnd = document.querySelector("#experience-end");
          if (experienceHead && experienceEnd) {
            created.push(
              ScrollTrigger.create({
                trigger: experienceHead,
                scroller: "#main",
                start: "top top+=20%",
                endTrigger: experienceEnd,
                end: "bottom top+=80%",
                pin: experienceHead,
                pinSpacing: false,
                anticipatePin: 1,
                markers: false,
              }),
            );
          }

          // MY STACK heading pin
          const myStackHeading = document.querySelector("#my-stack-heading");
          const myStackEnd = document.querySelector("#my-stack-end");
          const myStack = document.querySelector("#my-stack");
          if (myStack && myStackHeading && myStackEnd) {
            created.push(
              ScrollTrigger.create({
                trigger: myStack,
                scroller: "#main",
                start: "top top+=120",
                endTrigger: myStackEnd,
                end: "bottom top+=80%",
                pin: myStackHeading,
                pinSpacing: false,
                anticipatePin: 1,
                markers: false,
              }),
            );
          }

          // cleanup for this media query
          return () => {
            created.forEach((t) => t && t.kill && t.kill());
            created.length = 0;
          };
        });

        // Mobile: no large-screen pinning; still swap capability images on scroll
        mm.add("(max-width: 1023px)", () => {
          const sections = Array.from(
            document.querySelectorAll(".capability-section"),
          );
          const images = Array.from(
            document.querySelectorAll(".capability-image"),
          );
          const mobileTriggers = [];

          if (!images.length) return () => {};

          // show first image by default on mobile
          images.forEach((img, i) => img.classList.toggle("hidden", i !== 0));

          sections.forEach((section, index) => {
            mobileTriggers.push(
              ScrollTrigger.create({
                trigger: section,
                scroller: "#main",
                start: "top center",
                end: "bottom center",
                onEnter: () => {
                  images.forEach((img) => img.classList.add("hidden"));
                  if (images[index]) images[index].classList.remove("hidden");
                },
                onEnterBack: () => {
                  images.forEach((img) => img.classList.add("hidden"));
                  if (images[index]) images[index].classList.remove("hidden");
                },
                markers: false,
              }),
            );
          });

          return () => mobileTriggers.forEach((t) => t && t.kill && t.kill());
        });
      }, 250);
    });
  </script>
</BaseLayout>