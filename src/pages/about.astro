      </div>
    </div>
  </section>

  <AboutComponent />

  <Footer />
  
  <script is:inline>
    // Add to window.initPageScripts to be called on page transitions
    window.initPageScripts = () => {
      // Only create ScrollTrigger on larger screens
      if (window.innerWidth >= 1024) {
        ScrollTrigger.create({
          trigger: ".content",
          start: "top top",
          end: "bottom bottom",
          pin: ".left",
          pinSpacing: true,
          markers: true,
        });
      }
    };
    
    // Call immediately on first load
    window.initPageScripts();
    
    // Handle window resize
    window.addEventListener('resize', () => {
      ScrollTrigger.getAll().forEach(trigger => trigger.kill());
      setTimeout(window.initPageScripts, 100);
    });
  </script>
</BaseLayout>
