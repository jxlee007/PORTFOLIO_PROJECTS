---
const { title } = Astro.props;
---
<div class="w-full md:w-2/3 h-auto md:h-1/2 flex flex-col gap-3 md:gap-4">
  <h2 class="font-space-grotesk text-xl md:text-2xl font-bold">{title}</h2>
  <p class="uppercase text-lg md:text-xl font-space-grotesk tracking-wider leading-relaxed">
    <slot />
  </p>
</div>