---
const { title } = Astro.props;
---
<div class="w-full md:w-3/5 h-auto md:h-1/2 flex flex-col gap-5 md:gap-4 mb-16">
  <h2 class="font-space-grotesk text-2xl md:text-xl font-bold">{title}</h2>
  <p class=" text-white/80 uppercase text-md md:text-xl font-space-grotesk tracking-widest leading-8 ">
    <slot />
  </p>
</div>