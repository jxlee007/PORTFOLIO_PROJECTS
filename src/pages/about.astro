          <span class="text-5xl md:text-6xl font-bold font-space-grotesk text-white">4+</span>
          <span class="text-zinc-400 uppercase tracking-widest text-sm mt-2">YEARS OF EXPERIENCE</span>
        </div>
        <div class="flex flex-col items-center md:items-start">
          <span class="text-5xl md:text-6xl font-bold font-space-grotesk text-white">10+</span>
          <span class="text-zinc-400 uppercase tracking-widest text-sm mt-2">COMPLETED PROJECTS</span>
        </div>
      </div>
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10 md:gap-0">
        <div class="flex flex-col items-center md:items-start">
          <span class="text-5xl md:text-6xl font-bold font-space-grotesk text-white">$M</span>
          <span class="text-zinc-400 uppercase tracking-widest text-sm mt-2">PARTNERS RAISED</span>
        </div>
        <div class="flex flex-col items-center md:items-start">
          <span class="text-5xl md:text-6xl font-bold font-space-grotesk text-white">5.00</span>
          <span class="text-zinc-400 uppercase tracking-widest text-sm mt-2">CUSTOMER SUCCESS</span>
        </div>
      </div>
    </div>
  </section>

  <section
    class="content flex flex-col lg:flex-row gap-10 md:gap-20 bg-red-500 py-6 md:py-10 px-4 md:px-0"
  >
    <!-- Left Column -->
    <div
      id="pinlist"
      class="left border-2 border-white w-full lg:w-2/6 items-start justify-center"
    >
      <div class="pinlist">About me</div>
      <div class="pinlist">profileSummary</div>
      <div class="pinlist">experience</div>
      <div class="pinlist"></div>
    </div>

    <div class="h-full w-full lg:w-4/6 flex flex-col">
      <!-- Right Column -->
      <div
        class="border-2 border-white w-full lg:w-4/6 h-screen items-end justify-center"
      >
      </div>

      <div
        class="border-2 border-green-400 w-full lg:w-4/6 h-screen items-end justify-center"
      >
      </div>

      <div
        class="border-2 border-blue-400 w-full lg:w-4/6 h-screen items-end justify-center"
