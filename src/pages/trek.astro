// Utility to pick random item from array or parse string array
function getRandomImage(value) {
  // If it's already a string (single URL), return it
  if (typeof value === 'string') {
    // Check if it looks like an array string: "[ url1, url2, url3 ]"
    if (value.trim().startsWith('[') && value.trim().endsWith(']')) {
      try {
        // Clean up the string and split by comma
        const urls = value
          .replace(/[\[\]]/g, '') // Remove brackets
          .split(',')
          .map(url => url.trim())
          .filter(url => url.length > 0); // Remove empty strings
        
        if (urls.length > 0) {
          return urls[Math.floor(Math.random() * urls.length)];
        }
      } catch (e) {
        return value; // If parsing fails, return original string
      }
    }
    return value; // Regular single URL string
  }
  
  // If it's an array, pick random
  if (Array.isArray(value)) {
    return value[Math.floor(Math.random() * value.length)];
  }
  
  return value;
}

// Recursively process object and randomize any src that might be an array
function randomizeImageSources(obj) {
  if (Array.isArray(obj)) {
    return obj.map(item => randomizeImageSources(item));
  }
  
  if (obj !== null && typeof obj === 'object') {
    const result = {};
    
    for (const [key, value] of Object.entries(obj)) {
      // If key is 'src', process it for randomization
      if (key === 'src') {
        result[key] = getRandomImage(value);
      } else {
        result[key] = randomizeImageSources(value);
      }
    }
    
    return result;
  }
  
  return obj;
}

const data = randomizeImageSources(trekdata);


---

<BaseLayout title="My Trek | JX7 Portfolio">
  <Nav {menuItems} {brandLinks} />

  <section class="mt-10 px-4 md:px-0">
    <div
      class="font-bold font-space-grotesk w-full gap-8 md:gap-12 flex flex-col items-center justify-center"
    >
      <span class="text-center">
        <Split text="LOOK INTO" />
        <Split text="MY TREK" />
      </span>

      <p
        class="w-full md:w-2/3 text-zinc-400 leading-relaxed text-xl md:text-3xl mt-6 text-center tracking-wide font-light px-4 md:px-0"
      >
        GET INTO MY PLAYGROUND, WHERE CREATIVITY TAKES FLIGHT AND IDEAS BLOSSOM
        THROUGH IMAGINATION. STEP INTO A REALM WHERE INSPIRATION MEETS
        EXPRESSION.
      </p>
    </div>
  </section>

  <section class="trek-page pt-[2%] md:pt-[5%]">
    {
      data.sections.map((sectionGroup) => (
        <div class="section-group mb-24">
          {/* Hero Image Section */}
          <div class="hero-section relative h-96 md:h-[70vh] mb-16 md:mb-24 animate-item opacity-0 translate-y-6 will-change-transform overflow-hidden rounded-3xl shadow-2xl">
            <img
              src={sectionGroup.heroImage.src}
              alt={sectionGroup.heroImage.alt}
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center">
              <div class="text-center text-white/10 px-4">
                <h1 class="text-4xl md:text-6xl font-bold mb-4">
                  {sectionGroup.heroImage.title}
                </h1>
                <p class="text-lg md:text-xl max-w-3xl mx-auto ">
                  {sectionGroup.heroImage.subtitle}
                </p>
              </div>
            </div>
          </div>

          {/* Single Section Layout */}
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-1 md:grid-cols-1 md:gap-12 lg:grid-cols-2 mb-16">
            <div class="order-1 lg:order-1">
              <h2 class="text-2xl md:text-3xl font-bold mb-4">
                {sectionGroup.singleSection.title}
              </h2>
              <p class="text-base md:text-lg leading-relaxed mb-6">
                {sectionGroup.singleSection.description}
              </p>
              {sectionGroup.singleSection.link && (
                <a
                  href={sectionGroup.singleSection.link}
                  class="inline-block text-blue-500 hover:text-blue-700 font-medium transition"
                >
                  Learn More →
                </a>
              )}
            </div>
            <div class="order-2 lg:order-2">
              <img
                src={sectionGroup.singleSection.image.src}
                alt={sectionGroup.singleSection.image.alt}
                class="w-full h-auto rounded-lg shadow-lg"
              />
            </div>
          </div>

          {/* Dual Section Layout */}
          <div class=" mx-auto mb-16">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
              {/* Images container */}
              <div class="order-1 flex flex-col space-y-6 md:space-y-8">
                {sectionGroup.dualSection.images.map((image, index) => (
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="w-full object-cover aspect-[3/4] md:aspect-[4/3] sm:aspect-square rounded-lg shadow-lg"
                  />
                ))}
              </div>

              {/* Content container */}
              <div class="order-2 flex flex-col gap-10 space-y-6 md:space-y-8">
                {sectionGroup.dualSection.contents.map((content, index) => (
                  <div>
                    <h2 class="text-xl md:text-2xl font-bold mb-2">
                      {content.title}
                    </h2>
                    <p class="text-base md:text-lg leading-relaxed mb-4">
                      {content.description}
                    </p>
                    {content.link && (
                      <a
                        href={content.link}
                        class="inline-block text-blue-500 hover:text-blue-700 font-medium transition"
                      >
                        Learn More →
                      </a>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(() => {
        const items = Array.from(document.querySelectorAll(".animate-item"));
        if (!items.length) return;

        if (window.gsap && window.ScrollTrigger) {
          const gsap = window.gsap;
          const ScrollTrigger = window.ScrollTrigger;
          try {
            gsap.registerPlugin(ScrollTrigger);
          } catch (e) {}

          if (typeof ScrollTrigger.defaults === "function") {
            ScrollTrigger.defaults({ scroller: "#main" });
          }

          items.forEach((el, i) => {
            gsap.set(el, { autoAlpha: 0, y: 24 });
            gsap.to(el, {
              autoAlpha: 1,
              y: 0,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: {
                trigger: el,
                start: "top 85%",
                scroller: "#main",
                toggleActions: "play none none reverse",
                markers: false,
              },
            });
          });
          ScrollTrigger.refresh();
          return;
        }

        items.forEach((el) => {
          el.classList.remove("opacity-0", "translate-y-6");
        });
      }, 120);
    });
  </script>

  <Footer />
</BaseLayout>