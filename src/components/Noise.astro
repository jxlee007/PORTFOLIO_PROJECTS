---
export interface Props {
  patternSize?: number;
  patternScaleX?: number;
  patternScaleY?: number;
  patternRefreshInterval?: number;
  patternAlpha?: number;
}

const {
  patternSize = 250,
  patternScaleX = 1,
  patternScaleY = 1,
  patternRefreshInterval = 2,
  patternAlpha = 15,
} = Astro.props;

const canvasId = `noise-canvas-${Math.random().toString(36).substr(2, 9)}`;
---

<canvas 
  class="pointer-events-none absolute inset-0 w-full h-full" 
  id={canvasId}
  style="image-rendering: pixelated;"
  data-pattern-size={patternSize}
  data-pattern-scale-x={patternScaleX}
  data-pattern-scale-y={patternScaleY}
  data-pattern-refresh-interval={patternRefreshInterval}
  data-pattern-alpha={patternAlpha}
></canvas>

<script define:vars={{ canvasId }}>
  const canvas = document.getElementById(canvasId);
  if (canvas) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (ctx) {
      let frame = 0;
      let animationId;
      
      const patternRefreshInterval = parseInt(canvas.dataset.patternRefreshInterval || '2');
      const patternAlpha = parseInt(canvas.dataset.patternAlpha || '15');

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      };

      const drawGrain = () => {
        const imageData = ctx.createImageData(canvas.width, canvas.height);
        const data = imageData.data;
        
        for (let i = 0; i < data.length; i += 4) {
          const value = Math.random() * 255;
          data[i] = value;
          data[i + 1] = value;
          data[i + 2] = value;
          data[i + 3] = patternAlpha;
        }
        
        ctx.putImageData(imageData, 0, 0);
      };

      const loop = () => {
        if (frame % patternRefreshInterval === 0) {
          drawGrain();
        }
        frame++;
        animationId = window.requestAnimationFrame(loop);
      };

      window.addEventListener('resize', resize);
      resize();
      loop();

      // Cleanup when page unloads
      window.addEventListener('beforeunload', () => {
        window.removeEventListener('resize', resize);
        window.cancelAnimationFrame(animationId);
      });
    }
  }
</script>