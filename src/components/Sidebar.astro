---
import MenuLink from './MenuLink.astro';
import CustomLink from './CustomLink.astro';

interface MenuItem {
  href: string;
  index: string;
  label: string;
}

interface BrandLink {
  href: string;
  text: string;
}

export interface Props {
  menuItems: MenuItem[];
  brandLinks: BrandLink[];
}

const { menuItems, brandLinks } = Astro.props;
---
<div id="sidebar" class="sidenav h-screen w-0 fixed top-0 right-0 overflow-x-hidden transition-all duration-500 pt-[60px] bg-black z-[9999]">
  <div class="flex justify-between items-center mx-4 md:mx-8 border rounded-full border-white-800">
    <marquee class="text-sm md:text-xl font-semibold" direction="left" behavior="scroll" loop="infinite" scrollamount="10">
      <span class="text-gray-400 mr-2">+</span> LIGHT MODE COMING SOON <span class="text-gray-400 ml-2">+</span>
    </marquee>
    <button type="button" class="closebtn text-white text-lg md:text-2xl py-1 rounded-r-full hover:bg-white hover:text-black transition-all duration-300" onclick="closeNav()">
      <span class="px-2 md:px-3 border-l border-white text-sm md:text-base">CLOSE</span>
    </button>
  </div>

  <div id="reload" class="mt-8 md:mt-16 px-4 md:px-8">
    {menuItems.map(item => (
      <MenuLink href={item.href} index={item.index} label={item.label} />
    ))}
  </div>

  <div id="brand" class="absolute text-sm md:text-lg bottom-4 md:bottom-10 left-0 w-full px-4 md:px-8 flex flex-col md:flex-row gap-4 md:gap-0 md:justify-between">
    {brandLinks.map(link => (
      <CustomLink href={link.href} underline={true} className="text-gray-400 hover:text-white transition-colors duration-300">
        <span>{link.text}</span>
      </CustomLink>
    ))}
  </div>
</div>