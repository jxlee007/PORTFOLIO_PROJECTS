---
// Optional props for customization
export interface Props {
    size?: string;
    color?: string;
    zIndex?: string;
    blendMode?: string;
}

const {
    size = "17px",
    color = "white",
    zIndex = "99999",
    blendMode = "difference",
} = Astro.props;
---

<div
    id="dot"
    class={`fixed z-[${zIndex}] bg-${color} rounded-full mix-blend-${blendMode} pointer-events-none`}
    style={`width: ${size}; height: ${size}; top: 0; left: 0;`}
></div>

<script>
    import { gsap } from "gsap";

    function interactiveDot() {
        const dot = document.getElementById("dot");
        if (!dot) return; // Safety check

        // Generic hover targets (exclude reload menu links)
        const hoverElements = [
            ...Array.from(
                document.querySelectorAll("a:not(#reload .menu-item a)"),
            ),
            document.querySelector('[onclick="openNav()"]'),
        ].filter(Boolean);

        // All reload menu-item links
        const reloadLinks = document.querySelectorAll("#reload .menu-item a");

        hoverElements.forEach((elem) => {
            if (elem) {
                elem.addEventListener("mouseenter", () => {
                    // Use GSAP for smoother transitions
                    gsap.to(dot, {
                        duration: 0.3,
                        scale: 0,
                        opacity: 0,
                        ease: "power2.out"
                    });
                });

                elem.addEventListener("mouseleave", () => {
                    gsap.to(dot, {
                        duration: 0.3,
                        scale: 1,
                        opacity: 1,
                        ease: "power2.out"
                    });
                });
            }
        });

        // Bind transform/reset on each reload link
        reloadLinks.forEach((link) => {
            link.addEventListener("mouseenter", () => {
                dot.innerHTML = "OPEN";
                gsap.to(dot, {
                    duration: 0.3,
                    width: "70px",
                    height: "auto",
                    padding: "5px 15px",
                    borderRadius: "50px",
                    fontSize: "15px",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    color: "#000",
                    ease: "power2.out"
                });
            });

            link.addEventListener("mouseleave", () => {
                dot.innerHTML = ""; // Reset dot
                gsap.to(dot, {
                    duration: 0.3,
                    width: "17px",
                    height: "17px",
                    padding: 0,
                    borderRadius: "50%",
                    fontSize: 0,
                    display: "block",
                    ease: "power2.out"
                });
            });
        });

        // Cursor following functionality
        let mouseX = 0;
        let mouseY = 0;
        let currentX = 0;
        let currentY = 0;

        // Listen to mousemove on window and use pageX/pageY for full-page tracking
        window.addEventListener("mousemove", (e) => {
            mouseX = e.pageX;
            mouseY = e.pageY;

            let nearElement = false;
            hoverElements.forEach((elem) => {
                if (!elem) return;
                const rect = elem.getBoundingClientRect();
                const dx = e.clientX - (rect.left + rect.width / 2);
                const dy = e.clientY - (rect.top + rect.height / 2);
                const distance = Math.sqrt(dx * dx + dy * dy);
                if (distance < 50) {
                    nearElement = true;
                }
            });

            if (nearElement) {
                gsap.to(dot, {
                    duration: 0.3,
                    scale: 0,
                    opacity: 0,
                    ease: "power2.out"
                });
            } else {
                gsap.to(dot, {
                    duration: 0.3,
                    scale: 1,
                    opacity: 1,
                    ease: "power2.out"
                });
            }
        });

        // Smooth cursor following animation
        function animateDot() {
            const speed = 0.15;
            currentX += (mouseX - currentX) * speed;
            currentY += (mouseY - currentY) * speed;

            gsap.set(dot, {
                x: currentX,
                y: currentY,
                xPercent: -50,
                yPercent: -50
            });

            requestAnimationFrame(animateDot);
        }

        // Start animation loop
        animateDot();
    }

    // Initialize when DOM is ready
    document.addEventListener("DOMContentLoaded", function () {
        interactiveDot();
    });
</script>