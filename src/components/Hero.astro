---
import Nav from './Nav.astro';
import CustomLink from './CustomLink.astro';
import PulsingDot from './Pulsingdot.astro';

interface MenuItem {
  href: string;
  index: string;
  label: string;
}

interface BrandLink {
  href: string;
  text: string;
}

export interface Props {
  menuItems: MenuItem[];
  brandLinks: BrandLink[];
}

const { menuItems, brandLinks } = Astro.props;
---
<div id="hero" class="relative w-full h-screen">
  <Nav {menuItems} {brandLinks} />

  <div id="heading" class="mt-10 md:mt-16 mx-auto text-center display-grid place-items-center uppercase px-4 md:px-0">
    <div class="box w-fit flex items-center gap-2 overflow-hidden">
      <PulsingDot />
      <h5 class="boxelem text-lg md:text-xl font-space-grotesk tracking-wider">
        Available freelance
      </h5>
    </div>
    
    <div class="box w-fit overflow-hidden mx-auto">
      <h1 class="boxelem text-[20vw] md:text-[15vw] font-semibold leading-normal tracking-tighter text-white opacity-90 font-space-grotesk">
        <span>J</span>
        <span>X</span>
        <span>L</span>
        <span>E</span>
        <span>E</span>
      </h1>
    </div>

    <div class="block flex-col items-end w-fit mx-auto">
      <div class="box w-fit overflow-hidden">
        <h1 class="boxelem text-[20vw] md:text-[15vw] font-semibold leading-[0.9] text-white opacity-90 font-space-grotesk" id="sec">
          <span>0</span>
          <span>0</span>
          <span>7</span>
        </h1>
      </div>
    </div>
  </div>

  <div id="herofooter" class="w-full text-md md:text-lg absolute bottom-20 md:bottom-10 flex flex-col md:flex-row items-center justify-between gap-2 md:gap-0">
    <CustomLink href="#" underline={true} className="uppercase text-white text-center md:text-left hidden md:inline">
      <span>Based in India</span><i class="ri-arrow-right-up-line ml-1"></i>
    </CustomLink>
    <div class="w-full md:w-auto">
      <div class="block md:hidden overflow-x-hidden whitespace-nowrap">
      <div class="animate-marquee inline-block">
        <h1 class="text-xl uppercase text-white text-center">
        <span class="tracking-tight">&sol; &sol; &sol; </span>AI Builder + Creative Developer &nbsp;
        </h1>
      </div>
      <div class="animate-marquee inline-block" aria-hidden="true">
        <h1 class="text-xl uppercase text-white text-center">
        <span class="tracking-tight">&sol; &sol; &sol; </span>AI Builder + Creative Developer &nbsp;
        </h1>
      </div>
      </div>
      <div class="hidden md:block">
      <CustomLink href="/about" underline={true} className="uppercase text-white text-center md:text-right">
        <span class="tracking-tight">&sol; &sol; &sol; </span>AI Builder + Creative Developer
      </CustomLink>
      </div>
    </div>

    <style>
      @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-100%); }
      }
      .animate-marquee {
      display: inline-block;
      min-width: 100%;
      animation: marquee 10s linear infinite;
      }
    </style>
  </div>
</div>