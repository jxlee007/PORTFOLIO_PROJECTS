---
const { title, description, image, index } = Astro.props;
---
<section class="trek-section relative w-full py-16 md:py-24 animate-item opacity-0 translate-y-6 will-change-transform">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-center">
    <div class={`w-full lg:w-1/2 ${index % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}`}>
      <div class="relative overflow-hidden rounded-2xl shadow-2xl group">
        <div class="relative w-full pt-[75%]">
          <img 
            src={image} 
            alt={title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-br from-red-500/20 via-blue-500/20 to-purple-500/20 mix-blend-overlay opacity-60 group-hover:opacity-40 transition-opacity duration-700"></div>
        </div>
      </div>
    </div>

    <div class={`w-full lg:w-1/2 ${index % 2 === 0 ? 'lg:order-2' : 'lg:order-1'} space-y-6`}>
      <div class="flex items-center gap-4">
        <span class="text-sm font-bold tracking-[0.4em] text-red-400/80 font-space-grotesk">
          {String(index).padStart(2, '0')}
        </span>
        <div class="h-px flex-1 bg-gradient-to-r from-red-500/40 to-transparent"></div>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold uppercase tracking-tight font-space-grotesk leading-none">
        {title}
      </h2>
      
      <p class="text-zinc-400 text-lg md:text-xl leading-relaxed tracking-wide">
        {description}
      </p>
    </div>
  </div>
</section>
