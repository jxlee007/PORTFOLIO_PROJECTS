  <!-- inline GSAP reveal: subtle on-scroll animations for .animate-item -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // small delay so GSAP/ScrollTrigger (if loaded) has a chance to register
      setTimeout(() => {
        const items = Array.from(document.querySelectorAll('.animate-item'));
        if (!items.length) return;

        // If GSAP + ScrollTrigger available, use it for smoother reveals
        if (window.gsap && window.ScrollTrigger) {
          const gsap = window.gsap;
          const ScrollTrigger = window.ScrollTrigger;
          try {
            gsap.registerPlugin(ScrollTrigger);
          } catch (e) {
            // plugin may already be registered
          }

          // ensure all ScrollTrigger instances use the locomotive scroller
          if (typeof ScrollTrigger.defaults === "function") {
            ScrollTrigger.defaults({ scroller: "#main" });
          }

          items.forEach((el, i) => {
            // ensure starting state (in case CSS classes removed)
            gsap.set(el, { autoAlpha: 0, y: 18 });
            gsap.to(el, {
              autoAlpha: 1,
              y: 0,
              duration: 0.6,
              ease: 'power2.out',
              delay: 0,
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                scroller: '#main',
                toggleActions: 'play none none reverse',
                markers: false,
              },
            });
          });
          ScrollTrigger.refresh();
          return;
        }

        // Fallback (no GSAP): simply remove hidden classes for native appearance
        items.forEach((el) => {
          el.classList.remove('opacity-0', 'translate-y-6');
        });
      }, 120);
    });
  </script>
  <AboutComponent />

  <Footer />

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // small delay to allow other scripts/hydration to finish
      setTimeout(() => {
        if (!(window.gsap && window.ScrollTrigger)) return;
        const gsap = window.gsap;
        const ScrollTrigger = window.ScrollTrigger;
        const mm = gsap.matchMedia();
        // keep references to created ScrollTriggers for cleanup
        const created = [];

        const capabilityCards = Array.from(
          document.querySelectorAll(".capability-card"),
        );
        const experienceCards = Array.from(
          document.querySelectorAll(".experience-card"),
        );

        const createHighlightTriggers = (cards) => {
          if (!cards.length) return;
          const setActive = (target) => {
            cards.forEach((card) =>
              card.classList.toggle("is-active", card === target),
            );
          };

          // activate first card by default
          setActive(cards[0]);

          cards.forEach((card) => {
            ScrollTrigger.create({
              trigger: card,
              scroller: "#main",
              start: "top 70%",
              end: "bottom 40%",
              onEnter: () => setActive(card),
              onEnterBack: () => setActive(card),
              onLeave: () => card.classList.remove("is-active"),
              onLeaveBack: () => card.classList.remove("is-active"),
              markers: false,
            });
          });
        };

        createHighlightTriggers(capabilityCards);
        createHighlightTriggers(experienceCards);

        // Desktop: pins and image swap behavior
        mm.add("(min-width: 1024px)", () => {
          // EXPERIENCE heading pin
          const experienceHead = document.querySelector("#experience-headings");
          const experienceEnd = document.querySelector("#experience-end");
          if (experienceHead && experienceEnd) {
            created.push(
              ScrollTrigger.create({
                trigger: experienceHead,
                scroller: "#main",
                start: "top top+=20%",
                endTrigger: experienceEnd,
                end: "bottom top+=80%",
                pin: experienceHead,
                pinSpacing: false,
                anticipatePin: 1,
                markers: false,
              }),
            );
          }

          // CAPABILITIES heading pin
          const capabilitiesSection = document.querySelector("#capabilities");
          const capabilitiesHeading = document.querySelector("#capabilities-heading");
          const capabilitiesEnd = document.querySelector("#capabilities-end");
          if (capabilitiesSection && capabilitiesHeading && capabilitiesEnd) {
            created.push(
              ScrollTrigger.create({
                trigger: capabilitiesSection,
                scroller: "#main",
                start: "top top+=120",
                endTrigger: capabilitiesEnd,
                end: "bottom top+=80%",
                pin: capabilitiesHeading,
                pinSpacing: false,
                anticipatePin: 1,
                markers: false,
              }),
            );
          }

          // MY STACK heading pin
          const myStackHeading = document.querySelector("#my-stack-heading");
          const myStackEnd = document.querySelector("#my-stack-end");
          const myStack = document.querySelector("#my-stack");
          if (myStack && myStackHeading && myStackEnd) {
            created.push(
              ScrollTrigger.create({
                trigger: myStack,
                scroller: "#main",
                start: "top top+=120",
                endTrigger: myStackEnd,
                end: "bottom top+=80%",
                pin: myStackHeading,
                pinSpacing: false,
                anticipatePin: 1,
                markers: false,
              }),
            );
          }

          // cleanup for this media query
          return () => {
            created.forEach((t) => t && t.kill && t.kill());
            created.length = 0;
          };
        });

        ScrollTrigger.refresh();
      }, 250);
    });
  </script>
</BaseLayout>