---
import Nav from "../components/Nav.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import Dot from "../components/Dot.astro";

// Define menu items for the sidebar
const menuItems = [
  { href: "/", index: "/01", label: "MAIN HOME" },
  { href: "/about", index: "/02", label: "ABOUT JX7" },
  { href: "/work", index: "/03", label: "WORKS" },
  { href: "/trek", index: "/04", label: "MY TREK" },
  { href: "#contact", index: "/05", label: "CONTACT" },
];

// Define social media links
const brandLinks = [
  { href: "https://www.instagram.com/", text: "INSTAGRAM" },
  { href: "https://www.linkedin.com/", text: "LINKEDIN" },
  { href: "https://github.com/", text: "GITHUB" },
];

// Define work projects with more detail
const projects = [
  {
    id: 1,
    title: "PROJECT 1",
    subtitle: "/// cynthia ugwu",
    href: "#project1",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 2,
    title: "PROJECT 2",
    subtitle: "/// rayban-redesign",
    href: "#project2",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 3,
    title: "PROJECT 3",
    subtitle: "/// duo studio",
    href: "#project3",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 4,
    title: "PROJECT 4",
    subtitle: "/// rejoiuce",
    href: "#project4",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 5,
    title: "PROJECT 5",
    subtitle: "/// sundown studios",
    href: "#project5",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 6,
    title: "PROJECT 6",
    subtitle: "/// sundown studios",
    href: "#project6",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
  {
    id: 7,
    title: "Something new coming soon",
    subtitle: "/// sundown studios",
    href: "#project7",
    src: "https://flowbite.s3.amazonaws.com/docs/gallery/square/image-1.jpg",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work & Portfolio - JX7</title>

    <!-- External CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=general-sans@500,400&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=space-grotesk@500,400&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon and custom CSS -->
    <link rel="shortcut icon" href="/icon.ico" />
    <link rel="stylesheet" href="/style.css" />
  </head>

  <body class="bg-black text-white">
    <!-- Using the Dot component instead of hard-coded cursor dot -->
    <Dot />

    <!-- Main content container -->
    <main id="main" class="w-full h-fit bg-black">
      <!-- Hero section with just the navigation -->
      <div id="hero" class="relative w-full h-full gap-4 flex flex-col">
        <Nav {menuItems} {brandLinks} />

        <div
          class="w-full h-full px-10 mt-40 flex flex-row justify-between items-end gap-10"
        >
          <section class=" pr-40">
            <p
              class="uppercase text-gray-400 text-xl/3 font-space-grotesk tracking-wider leading-relaxed"
            >
              My creative spirit comes alive in the digital realm. With nimble
              fingers flying across the keyboard, I craft clear experiences out
              of nothing but ones and zeroes.
            </p>
          </section>

          <section class="flex flex-col items-end text-[9.8vw] font-bold">
            <p class="uppercase text-xl text-gray-300 font-thin">
              ( 2021 - 2024 )
            </p>

            <p class=" leading-none line-clamp-2 text-right mt-4 " >SELECTED WORKS</p>
          </section>
        </div>
      </div>

      <!-- Projects gallery -->
      <section
        id="third"
        class="py-20 px-10 w-full h-fit flex flex-col justify-items-end gap-12"
      >
        <div class="w-full h-full">
          <div class="grid grid-cols-2 gap-2">
            {
              projects.map((project) => (
                <ProjectCard
                  href={project.href}
                  src={project.src}
                  title={project.title}
                  subtitle={project.subtitle}
                />
              ))
            }
          </div>
        </div>
      </section>

      <!-- Footer section -->
      <Footer goHref="#hero" title="JAGMOHAN" />
    </main>

    <!-- Scripts for animation and interaction -->
    <script
      src="https://cdn.jsdelivr.net/npm/locomotive-scroll@3.5.4/dist/locomotive-scroll.min.js"
      is:inline></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
      is:inline></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
      is:inline></script>
    <script src="/scripts/script.js" is:inline></script>
  </body>
</html>
