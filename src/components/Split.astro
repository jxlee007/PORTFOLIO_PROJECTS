---
export interface Props {
    text?: string;
}

const { text = "The text in this paragraph is split by words and lines. We have enabled masking on the lines so that we can animate the lines to create a fun 'reveal' animation. Nice and easy!" } = Astro.props;
---

<div class="max-w-full">
    <h1 class="opacity-0 text-center text-white text-5xl md:text-7xl lg:text-[9.5vw] tracking-normal  split">{text}</h1>
</div>

<style>
    /* This specific style is hard to implement in Tailwind */
    .split * {
        will-change: transform;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { SplitText } from "gsap/SplitText";
    
    // Register the SplitText plugin with GSAP
    gsap.registerPlugin(SplitText);
    
    // Wait for fonts to be loaded to avoid layout shifts
    document.fonts.ready.then(() => {
        // Make the text visible initially (was set to opacity 0 in CSS)
        gsap.set(".split", { opacity: 1 });
        
        let split;
        // Create the SplitText instance
        SplitText.create(".split", {
            type: "words,lines",
            linesClass: "line",
            autoSplit: true,
            mask: "lines",
            onSplit: (self) => {
                // Animate lines from bottom to top with a reveal effect
                split = gsap.from(self.lines, {
                    duration: 0.6,
                    yPercent: 100,
                    opacity: 0,
                    stagger: 0.1,
                    ease: "expo.out",
                });
                return split;
            }
        });
    });
</script>
