    { href: "https://www.instagram.com/", text: "INSTAGRAM" },
    { href: "https://www.linkedin.com/", text: "LINKEDIN" },
    { href: "https://github.com/", text: "GITHUB" },
];

/* Generate random link from the array */
const randomLink =
    pixelArtLinks[Math.floor(Math.random() * pixelArtLinks.length)];
---

<BaseLayout title="CONTACT-JX7">
    <!-- Hero section with just the navigation -->
    <div id="hero" class="w-full flex flex-col my-2 md:my-4">
        <Nav {menuItems} {brandLinks} />

        <!-- Hero content section - Responsive with flex direction changes -->
        <div
            class="w-full h-fit sm:pr-10 mt-6 md:mt-10 flex flex-col lg:flex-row justify-between gap-6 md:gap-10 px-4 md:px-0"
        >
            <div
                class="w-full sm:pr-10 md:w-1/2 mt-6 md:mt-10 flex flex-col gap-8 md:gap-16 order-1"
                id="form-section"
            >
                <span class="flex flex-col items-start gap-4 md:gap-6">
                    <p
                        class="text-5xl tracking-wide font-bold uppercase text-left"
                    >
                        RING A BELL!
                    </p>

                    <p
                        class="uppercase text-gray-400 text-lg md:text-xl font-thin font-space-grotesk tracking-widest leading-relaxed text-left"
                    >
                        REACH OUT AND LET'S CREATE SOMETHING AMAZING TOGETHER.
                        LET'S ACHIEVE GREATNESS.
                    </p>
                </span>

                <!-- Form column - Takes full width on mobile -->
                <span class="rounded-2xl col-span-1 md:col-span-2">
                    <form class="flex flex-col gap-4 text-left">
                        <h3
                            class=" text-2xl tracking-wider font-space-grotesk font-bold mt-4 uppercase text-left"
                        >
                            FILL THIS FORM OUT
                        </h3>

                        <!-- Stack form fields on mobile -->
                        <div
                            class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6"
                        >
                            <div class="flex flex-col">
                                <input
                                    type="text"
                                    id="name"
                                    class="bg-zinc-900 text-white text-lg md:text-xl p-3 md:p-4 rounded-xl border-0 uppercase"
                                    placeholder="NAME"
                                />
                            </div>

                            <div class="flex flex-col">
                                <input
                                    type="email"
                                    id="email"
                                    class="bg-zinc-900 text-white text-lg md:text-xl p-3 md:p-4 rounded-xl border-0 uppercase"
                                    placeholder="E-MAIL"
                                />
                            </div>
                        </div>

                        <div class="flex flex-col">
                            <textarea
                                id="message"
                                rows="5"
                                class="bg-zinc-900 text-white text-lg md:text-xl p-3 md:p-4 rounded-xl border-0 resize-none uppercase"
                                placeholder="MESSAGE"></textarea>
                        </div>

                        <!-- Button is more prominent on mobile -->
                        <button
                            type="submit"
                            class="bg-white text-black p-4 md:p-6 uppercase rounded-xl font-semibold tracking-wide hover:bg-slate-300 transition-colors duration-300 w-full text-lg md:text-xl text-center"
                        >
                            SEND EMAIL
                        </button>
                    </form>
                </span>
            </div>

            <section
                class=" md:absolute right-0 md:right-5 w-full md:w-1/2 h-full md:h-screen order-2 "
                id="image-section"
            >
                <div class=" h-full w-full overflow-hidden">
                    <img
                        src={randomLink}
                        alt="Contact image"
                        class="w-full h-full object-cover rounded-2xl"
                    />
                </div>
            </section>
        </div>

        <!-- Contact section - Fully responsive -->
        <div
            id="contact"
            class="mt-10 sm:pr-10 py-6 md:py-10 w-full md:w-1/2 h-fit flex flex-col items-center"
        >
            <!-- Single column stacked layout for desk (and mobile) -->
            <div class="flex flex-col w-full gap-6 md:gap-10">
                <!-- Block 1 - Follow Me -->
                <div class="flex text-center w-full">
                    <div
                        class="text-lg md:text-xl font-space-grotesk font-medium flex flex-col w-full"
                    >
                        <p
                            class="text-gray-400 text-base md:text-lg uppercase font-medium mb-4"
                        >
                            FOLLOW ME
                        </p>

                        <div class="flex flex-col gap-2 md:gap-3">
                            <CustomLink
                                href="https://www.instagram.com/"
                                target="_blank"
                                className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                            >
                                <span
                                    >INSTAGRAM<i
                                        class="ri-arrow-right-up-line ml-1"
                                    ></i></span
                                >
                            </CustomLink>
                            <CustomLink
                                href="https://www.linkedin.com/in/jagmohan-singh-malhi-a67805243/"
                                target="_blank"
                                className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                            >
                                <span
                                    >LINKEDIN<i
                                        class="ri-arrow-right-up-line ml-1"
                                    ></i></span
                                >
                            </CustomLink>
                            <CustomLink
                                href="https://github.com/jxlee007"
                                target="_blank"
                                className="text-white hover:text-black hover:bg-white transition-colors duration-300"
                            >
                                <span
                                    >GITHUB<i
                                        class="ri-arrow-right-up-line ml-1"
                                    ></i></span
                                >
                            </CustomLink>
                        </div>
                    </div>
                </div>

                <!-- Block 2 - Phone -->
                <div class="py-4 md:py-8 rounded-2xl w-full text-center">
                    <p
                        class="text-gray-400 text-base md:text-lg mb-2 md:mb-3 uppercase"
                    >
                        PHONE
                    </p>
                    <p class="text-white text-lg md:text-xl uppercase">
                        +91 7600925494
                    </p>
                </div>

                <!-- Block 3 - Location -->
                <div class="py-4 md:py-8 rounded-2xl w-full text-center">
                    <p
                        class="text-gray-400 text-base md:text-lg mb-2 md:mb-3 uppercase"
                    >
                        CURRENT LOCATION
                    </p>
                    <p class="text-white text-lg md:text-xl uppercase">
                        INDIA, GMT+5:30
                    </p>
                    <p class="text-white text-lg md:text-xl uppercase">
                        GUJARAT
                    </p>
                </div>
            </div>
        </div>

        <hr id="end" class="border border-transparent" />
    </div>

    <!-- Footer section -->
    <div class="pt-20">
        <Footer goHref="#hero" title="JAGMOHAN" />
    </div>

    <!-- GSAP Split Screen Pinning Script -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            // Wait a bit for LocomotiveScroll / SSR hydration to finish
            setTimeout(() => {
                if (window.gsap && window.ScrollTrigger) {
                    const gsap = window.gsap;
                    const ScrollTrigger = window.ScrollTrigger;

                    // Use GSAP matchMedia for responsive behavior
                    const mm = gsap.matchMedia();

                    // Desktop: pin the image section beside the form and scrub the image animation
                    mm.add("(min-width: 768px)", () => {
                        const pinST = ScrollTrigger.create({
                            trigger: "#image-section",
                            scroller: "#main",
                            start: "top top",
                            endTrigger: "#end",
                            end: "bottom bottom",
                            pin: true,
                            pinSpacing: false,
                            anticipatePin: 1,
                            markers: false,
                        });
                        // cleanup when leaving this media query
                        return () => {
                            pinST.kill();
                        };
                    });


                    // Optional: handle other queries or a default cleanup on destroy
                    // mm.add(() => { return () => mm.revert(); });
                }
            }, 500);
        });
    </script>
</BaseLayout>
