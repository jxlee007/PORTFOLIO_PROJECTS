---
import Sidebar from './Sidebar.astro';
import Peace from './Peace.astro';
import Icon from './icon.astro';
import CustomLink from './CustomLink.astro';
import Remix from './Remix.astro';

interface MenuItem {
  href: string;
  index: string;
  label: string;
}

interface BrandLink {
  href: string;
  text: string;
}

export interface Props {
  menuItems: MenuItem[];
  brandLinks: BrandLink[];
}

const { menuItems, brandLinks } = Astro.props;
---
<div id="nav" class="w-full py-4 md:py-8 flex items-center justify-between px-4 md:px-0">
<div class="flex items-center gap-2 md:gap-4">
  <Remix />

  <CustomLink href="/contact" className="text-white">
    <Icon ico="/images/call.png" />
  </CustomLink>
</div>
  
  <span class="cursor-pointer flex items-center" onclick="openNav()">
    <div class="w-6 h-6 md:w-8 md:h-8 flex items-center border-2 border-white rounded-full bg-white">
      <Peace />
    </div>
  </span>
  
  <Sidebar {menuItems} {brandLinks} />
</div>