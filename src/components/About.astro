---

<section
  id="about"
  class="py-10 md:py-20 w-full h-fit flex flex-col items-center gap-8 md:gap-12 px-4 md:px-0"
>
  <h1
    class="w-full h-fit text-4xl md:text-8xl font-space-grotesk font-semibold text-white text-center tracking-normal"
  >
    LET'S WORK<br />TOGETHER
  </h1>

  <Link href="#contact" target="_self">CONTACT NOW*</Link>

  <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-0">
    <div class="py-20 md:py-56 text-center flex flex-col justify-center">
      <h2
        class="uppercase text-base md:text-lg font-space-grotesk tracking-wider leading-relaxed"
      >
        Connect yourself<br />into Cyberpunk universe.
      </h2>
    </div>

    <div class="relative flex justify-center items-center">
      <img
        src={randomLink}
        alt="Random Pixel Art"
        class="w-[300px] h-[400px] object-cover rounded-[25px] absolute z-0"
        loading="lazy"
      />
      <Pixelcard variant="pink" className="relative z-10">
      </Pixelcard>
    </div>

    <div class="py-20 md:py-56 text-center flex flex-col justify-center">
      <h2
        class="uppercase text-base md:text-lg font-space-grotesk tracking-wider leading-relaxed"
      >
        Innovation is an<br />outlet for your vision.
      </h2>
    </div>
  </div>

  <p
    class="uppercase text-sm md:text-md font-semibold text-center tracking-wider w-full md:w-1/2 px-4 md:px-16"
  >
    <span class="text-white">
      I am always open to new opportunities and collaborations. If you have a
      project in mind or just want to say hi, feel free to reach out!
    </span>
  </p>

  <div
    class="font-space-grotesk text-lg md:text-xl font-thin w-full md:w-1/3 flex flex-col md:flex-row gap-4 md:gap-0 justify-between items-center"
  >
    <CustomLink target="_blank" href={socialLinks.instagram}>
      <span>INSTAGRAM<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
    <CustomLink target="_blank" href={socialLinks.linkedin}>
      <span>LINKEDIN<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
    <CustomLink target="_blank" href={socialLinks.github}>
      <span>GITHUB<i class="ri-arrow-right-up-line ml-1"></i></span>
    </CustomLink>
  </div>
</section>
    </CustomLink>
  </div>
</section>
