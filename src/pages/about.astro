---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Dot from "../components/Dot.astro";
import CustomLink from "../components/CustomLink.astro";
import Split from "../components/Split.astro";
import AboutComponent from "../components/About.astro";

// Define menu items for the sidebar (same as index page)
const menuItems = [
  { href: "/", index: "/01", label: "MAIN HOME" },
  { href: "/about", index: "/02", label: "ABOUT JX7" },
  { href: "/work", index: "/03", label: "WORKS" },
  { href: "/trek", index: "/04", label: "MY TREK" },
  { href: "/contact", index: "/05", label: "CONTACT" },
];

// Define social media links
const brandLinks = [
  { href: "https://www.instagram.com/", text: "INSTAGRAM" },
  { href: "https://www.linkedin.com/", text: "LINKEDIN" },
  { href: "https://github.com/", text: "GITHUB" },
];

// Statistics
const stats = [
  { value: "2+", label: "YEARS" },
  { value: "5+", label: "PROJECTS" },
  { value: "$1M+", label: "REVENUE" },
  { value: "6.2K", label: "FOLLOWERS" },
];

// Projects
const projects = [
  { title: "FRONT-END PROJECTS", type: "DIGITAL TWIN", year: "2024" },
  { title: "PINTEREST CLONE", type: "Embedded JS", year: "2023" },
  { title: "ANDROID CHAT APP", type: "JAVA", year: "2022" },
  { title: "CYNTHIA UGWU", type: "PORTFOLIO SITE", year: "2021" },
];

// Capabilities
const capabilities = [
  {
    title: "CREATIVE VISION DIRECTION",
    description:
      "Leading digital experiences from concept to execution with a forward-thinking approach that pushes technological boundaries.",
    image: "/images/image.png",
  },
  {
    title: "NEURAL ARTS ENGINE",
    description:
      "Combining AI algorithms with creative direction to generate unique artistic expressions and interactive visuals.",
    image: "/images/image.png",
  },
  {
    title: "DIGITAL DIMENSIONS",
    description:
      "Building immersive spaces that bridge the gap between reality and digital worlds through cutting-edge WebGL and Three.js.",
    image: "/images/image.png",
  },
];

const contactDetails = [
  { label: "Mobile", value: "7600925494" },
  { label: "Email", value: "jagmohansinghmalhi20@gmail.com" },
  {
    label: "LinkedIn",
    value: "https://www.linkedin.com/in/jagmohan-singh-malhi-a67805243",
  },
  { label: "GitHub", value: "https://github.com/jxlee007" },
  { label: "Portfolio", value: "https://jxlee007.github.io/" },
];
const topSkills = ["No-Code Development Platforms", "AI Agents", "Jira"];
const certifications = [
  "JavaScript for beginners",
  "Introduction to HTML Course",
  "Back End Development and APIs",
];
const profileSummary = `I'm a no-code developer with a passion for building intuitive and
scalable digital solutions using tools like Bubble, Xano, and Make.
With a year of experience in project management, I've successfully
led projects from ideation to execution, ensuring efficiency and
innovation.
I also have a strong frontend web development foundation, creating
visually appealing and user-friendly websites using HTML, CSS, and
JavaScript. My expertise in AI and prompt engineering allows me to
integrate automation and intelligent solutions into web experiences,
making them smarter and more efficient.
I'm always eager to learn, innovate, and push creative boundaries.
Currently open to collaborations where I can apply my skills in
frontend and no-code development. Let's connect and build
something amazing! ✨`;
const profileExperience = [
  {
    company: "Kit Solutions",
    position: "IT Business Analyst",
    period: "April 2024 - April 2025",
    location: "Vadodara, Gujarat, India",
  },
  {
    company: "InternPe",
    position: "Web Development Intern",
    period: "November 2023 - November 2023",
    location: "Jaipur, Rajasthan, India",
  },
];
const education = [
  {
    institution: "Parul University",
    degree: "Bachelor's in Computer Application, Cybersecurity",
    period: "August 2021 - April 2024",
  },
];
---

<BaseLayout title="About | JX7 Portfolio">
  <!-- Using the Dot component for cursor -->
  <Dot />

  <!-- Navigation -->
  <Nav {menuItems} {brandLinks} />

  <!-- About Header Section -->
  <section class="mt-10 pb-10">
    <div
      class="font-bold font-space-grotesk w-full h-fit gap-10 flex flex-col items-center justify-center"
    >
      <span>
        <Split text="MORE ABOUT " />
        <Split text="JXLEE" />
      </span>

      <p
        class="w-2/3 text-zinc-400 leading-relaxed text-xl mt-4 text-center tracking-wide font-light"
      >
        UNLEASH YOUR CREATIVITY. SHOWCASE YOU WORK AND <br />
        HIGHLIGHT YOUR UNIQUE SKILLS TO ATTRACT NEW CLIENTS.
      </p>
    </div>
  </section>

  <!-- Statistics Section -->
  <section
    class="grid grid-cols-4 gap-4 px-10 py-6 border-y border-zinc-800"
  >
    {
      stats.map((stat) => (
        <div class="flex flex-col">
          <h2 class="text-3xl md:text-5xl font-bold font-space-grotesk">
            {stat.value}
          </h2>
          <span class="text-zinc-400 uppercase text-sm">{stat.label}</span>
        </div>
      ))
    }
  </section>

  <section
    class="content flex flex-row gap-20 bg-red-500 py-10"
  >
    <!-- Left Column -->
    <div
      id="pinlist"
      class="left border-2 border-white  w-2/6 items-start justify-center"
    >
      <div class="pinlist">About me</div>
      <div class="pinlist">profileSummary</div>
      <div class="pinlist">experience</div>
      <div class="pinlist"></div>
    </div>

    <div class="h-full w-4/6 flex flex-col">
      <!-- Right Column -->
      <div
        class=" border-2 border-white w-4/6 h-screen items-end justify-center"
      >
      </div>

      <div
        class="border-2 border-green-400 w-4/6 h-screen items-end justify-center"
      >
      </div>

      <div
        class="border-2 border-blue-400 w-4/6 h-screen items-end justify-center"
      >
      </div>
    </div>
  </section>

  <AboutComponent />

  <Footer />
  
  <script is:inline>
    // Add to window.initPageScripts to be called on page transitions
    window.initPageScripts = () => {
      ScrollTrigger.create({
        trigger: ".content",
        start: "top top",
        end: "bottom bottom",
        pin: ".left",
        pinSpacing: true,
        markers: true,
      });
    };
    
    // Call immediately on first load
    window.initPageScripts();
  </script>
</BaseLayout>
