---

<section id="third" class="py-10 md:py-20 w-full h-fit flex flex-col justify-items-end gap-8 md:gap-12 px-4 md:px-0">
  <h1 class="w-full h-fit grid grid-flow-col justify-items-center md:justify-items-end text-5xl md:text-8xl font-space-grotesk font-semibold text-white tracking-normal">
    FEATURED CASES
  </h1>

  <div class="grid grid-flow-row justify-items-start gap-6 md:gap-10">
    <span class="w-full md:w-4/5 md:pr-28 flex flex-col gap-4">
      <p class="uppercase text-lg md:text-2xl font-space-grotesk tracking-wider leading-relaxed">
        My creative spirit comes alive in the digital realm. With nimble fingers flying across the keyboard, 
        I craft clear experiences out of nothing but ones and zeroes.
      </p>
    </span>

    <Link href="/work">VIEW PORTFOLIO *</Link>
  </div>

  <div class="max-w-full h-full lg:hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      {mobileProjects.map(project => (
        <ProjectCard 
          href={project.href}
          src={project.src}
          title={project.title}
          subtitle={project.subtitle}
        />
      ))}
    </div>
  </div>

  <div class="hidden lg:block w-full relative">
    <div
      id="featured-fixed"
      class="featured-fixed pointer-events-none fixed top-[22vh] left-[58%] w-[24vw] h-[30vw] rounded-2xl overflow-hidden border border-white/20 shadow-[0_40px_90px_rgba(0,0,0,0.45)] bg-black/80 backdrop-blur-md"
    ></div>

    <div id="featured-list" class="featured-list flex flex-col">
      {desktopProjects.map((project) => (
        <article
          class="featured-elem"
          data-media-type={project.mediaType}
          data-media-src={project.mediaSrc}
          data-project-id={project.id}
          data-href={project.href}
          role="button"
          tabindex="0"
          aria-label={`Preview ${project.title} project`}
        >
          <div class="featured-overlay" aria-hidden="true"></div>
          <h2>{project.title}</h2>
          <div class="featured-meta">
            <h3>{project.brand}</h3>
            <h4>{project.category}</h4>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .featured-list {
      position: relative;
      gap: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .featured-elem {
      position: relative;
      height: 150px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 2.5vw;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
      text-transform: uppercase;
      transition: color 0.25s ease, transform 0.2s ease;
      cursor: pointer;
    }

    .featured-elem:hover {
      transform: translateX(4px);
    }

    .featured-elem:last-child {
      border-bottom: none;
    }

    .featured-elem h2 {
      font-size: clamp(2.5rem, 2.6vw, 3.4rem);
      font-weight: 600;
      color: #f7f7f7;
      letter-spacing: 0.08em;
      position: relative;
      z-index: 2;
    }

    .featured-meta {
      width: 14%;
      min-width: 180px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      position: relative;
      z-index: 2;
    }

    .featured-meta h3 {
      font-size: clamp(1rem, 1.1vw, 1.4rem);
      font-weight: 500;
      letter-spacing: 0.2em;
      color: #f3f3f3;
    }

    .featured-meta h4 {
      font-size: clamp(0.9rem, 1vw, 1.2rem);
      text-transform: capitalize;
      font-weight: 400;
      color: #b3b3b3;
    }

    .featured-overlay {
      position: absolute;
      inset: 0;
      background: #ff9831;
      transform: translateY(-100%);
      transition: transform 0.25s ease;
      z-index: 1;
    }

    .featured-elem:is(:hover, :focus-visible) .featured-overlay {
      transform: translateY(0%);
    }

    .featured-elem:is(:hover, :focus-visible) h2,
    .featured-elem:is(:hover, :focus-visible) .featured-meta h3,
    .featured-elem:is(:hover, :focus-visible) .featured-meta h4 {
      color: #101010;
    }

    .featured-fixed {
      display: none;
      justify-content: center;
      align-items: center;
    }

    .featured-fixed.is-visible {
      display: flex;
    }

    .featured-fixed video,
    .featured-fixed img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 16px;
    }
  }
</style>

<script type="module">
  const initFeaturedCases = () => {
    const fixed = document.getElementById('featured-fixed');
    const list = document.getElementById('featured-list');

    if (!fixed || !list) {
      return () => {};
    }

    const mq = window.matchMedia('(min-width: 1024px)');
    const listeners = [];

    const hideMedia = () => {
      fixed.classList.remove('is-visible');
      fixed.replaceChildren();
    };

    const showMedia = (type, src) => {
      if (!src) return;

      const fragment = document.createDocumentFragment();

      if (type === 'video') {
        const video = document.createElement('video');
        video.src = src;
        video.autoplay = true;
        video.loop = true;
        video.muted = true;
        video.playsInline = true;
        video.setAttribute('aria-hidden', 'true');
        fragment.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = src;
        img.alt = '';
        fragment.appendChild(img);
      }

      fixed.replaceChildren(fragment);
      fixed.classList.add('is-visible');
    };

    const attachListeners = () => {
      if (!mq.matches) {
        return;
      }

      const elements = list.querySelectorAll('.featured-elem');

      elements.forEach((elem) => {
        const handleEnter = () => {
          const { mediaType, mediaSrc } = elem.dataset;
          showMedia(mediaType, mediaSrc);
        };

        const handleLeave = () => {
          hideMedia();
        };

        const handleClick = () => {
          const { href } = elem.dataset;
          if (href && href !== '#' && href !== 'PROJECT-2' && href !== 'PORTFOLIO') {
            window.open(href, '_blank', 'noopener,noreferrer');
          }
        };

        const handleKeydown = (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            handleClick();
          }
        };

        elem.addEventListener('mouseenter', handleEnter);
        elem.addEventListener('focus', handleEnter);
        elem.addEventListener('mouseleave', handleLeave);
        elem.addEventListener('blur', handleLeave);
        elem.addEventListener('click', handleClick);
        elem.addEventListener('keydown', handleKeydown);

        listeners.push({ elem, handleEnter, handleLeave, handleClick, handleKeydown });
      });

      list.addEventListener('mouseleave', hideMedia);
      listeners.push({ elem: list, handleLeave: hideMedia });
    };

    const detachListeners = () => {
      listeners.forEach(({ elem, handleEnter, handleLeave, handleClick, handleKeydown }) => {
        if (handleEnter) {
          elem.removeEventListener('mouseenter', handleEnter);
          elem.removeEventListener('focus', handleEnter);
        }
        if (handleLeave) {
          elem.removeEventListener('mouseleave', handleLeave);
          elem.removeEventListener('blur', handleLeave);
        }
        if (handleClick) {
          elem.removeEventListener('click', handleClick);
        }
        if (handleKeydown) {
          elem.removeEventListener('keydown', handleKeydown);
        }
      });
      listeners.length = 0;
      hideMedia();
    };

    const handleChange = (event) => {
      if (event.matches) {
        attachListeners();
      } else {
        detachListeners();
      }
    };

    if (mq.matches) {
      attachListeners();
    }

    mq.addEventListener('change', handleChange);

    return () => {
      mq.removeEventListener('change', handleChange);
      detachListeners();
    };
  };

  if (typeof window !== 'undefined') {
    let cleanup = () => {};

    const onReady = () => {
      cleanup = initFeaturedCases();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', onReady, { once: true });
    } else {
      onReady();
    }

    window.addEventListener('beforeunload', () => {
      cleanup();
    });
  }
</script>