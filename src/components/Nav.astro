---
import Sidebar from './Sidebar.astro';
import Peace from './Peace.astro';
import Icon from './icon.astro';
import CustomLink from './CustomLink.astro';

interface MenuItem {
  href: string;
  index: string;
  label: string;
}

interface BrandLink {
  href: string;
  text: string;
}

export interface Props {
  menuItems: MenuItem[];
  brandLinks: BrandLink[];
}

const { menuItems, brandLinks } = Astro.props;
---
<div id="nav" class=" w-full py-8 flex items-center justify-between">
<div class="flex items-center gap-4">
  <a id="remix" href="#" class="flex rounded-full bg-white font-semibold text-black  duration-300">
    REMIX / &nbsp; <h5 id="realtime"></h5>
  </a>
  
  <CustomLink href="/contact" className="text-white">    
    <Icon ico="/images/call.png" />
  </CustomLink>
</div>
  
  <span class="cursor-pointer flex items-center" onclick="openNav()">
    <div class="w-8 h-8 flex items-center border-2 border-white rounded-full bg-white">
      <Peace />
    </div>
  </span>
  
  <Sidebar {menuItems} {brandLinks} />
</div>